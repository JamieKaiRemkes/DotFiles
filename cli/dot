#!/usr/bin/env bash
# dot — dotfiles CLI. Works from any directory.
set -euo pipefail

DOTFILES_DIR="$HOME/.dotfiles"
GIT="git --git-dir=$DOTFILES_DIR --work-tree=$HOME"

# ── Helpers ───────────────────────────────────────────────
info()  { printf '\033[1;34m→ %s\033[0m\n' "$*"; }
ok()    { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn()  { printf '\033[1;33m⚠ %s\033[0m\n' "$*"; }

usage() {
    cat <<EOF
Usage: dot <command> [args]

Commands:
  sync          Pull (rebase + autostash) and push
  install       Run the dotfiles installer
  brew-sync     Merge remote Brewfile, install, dump & push
  edit          Open dotfiles in \$EDITOR
  <git args>    Pass any git command to the bare repo

Examples:
  dot sync
  dot brew-sync
  dot status
  dot add -f ~/.config/some/file
  dot commit -m "feat: add config"
  dot log --oneline
EOF
}

# ── Commands ──────────────────────────────────────────────
cmd_sync() {
    info "Pulling latest…"
    $GIT pull --rebase --autostash
    info "Pushing…"
    $GIT push
    ok "Synced"
}

cmd_install() {
    bash "$HOME/install.sh" "$@"
}

cmd_brew_sync() {
    info "Pulling latest…"
    $GIT pull --rebase --autostash

    info "Installing packages from Brewfile…"
    brew bundle install --file="$HOME/Brewfile" || true

    info "Dumping current packages to Brewfile…"
    brew bundle dump --force --file="$HOME/Brewfile"

    $GIT add -f "$HOME/Brewfile"
    if $GIT diff --cached --quiet "$HOME/Brewfile"; then
        ok "Brewfile already up to date"
    else
        $GIT commit -m "chore(brew): update Brewfile"
        $GIT push
        ok "Brewfile updated and pushed"
    fi
}

cmd_edit() {
    GIT_WORK_TREE="$HOME" GIT_DIR="$DOTFILES_DIR" \
        $EDITOR --wait=false --new-window "$HOME"
}

# ── Entrypoint ────────────────────────────────────────────
case "${1:-}" in
    ""|-h|--help|help) usage ;;
    sync)       shift; cmd_sync "$@" ;;
    install)    shift; cmd_install "$@" ;;
    brew-sync)  shift; cmd_brew_sync "$@" ;;
    edit)       shift; cmd_edit "$@" ;;
    *)          $GIT "$@" ;;
esac
